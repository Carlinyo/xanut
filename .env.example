# Пример переменных окружения. Скопируйте в .env.local и подставьте свои значения.
# Файлы .env и .env.* не попадают в git (см. .gitignore), сюда — только безопасные примеры без секретов.

# Куда проксировать /api во время разработки (vite dev/preview).
# По умолчанию локальный сервер; задеплоенный бэкенд — раскомментируйте строку ниже.
API_PROXY_TARGET=http://127.0.0.1:3000
# API_PROXY_TARGET=https://xanutback.vercel.app

# Необязательно: другой домен API для сборки (иначе запросы идут на /api этого же сайта).
# В проде проксирование на бэкенд делает vercel.json (rewrites), эта переменная обычно не нужна.
# VITE_API_URL=
